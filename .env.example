# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hospital_supply_chain

# MongoDB Community Server or MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=hospital_supply_chain_events

# Secret used to sign login cookies. Use a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
